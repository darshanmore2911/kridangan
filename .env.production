# Production environment variables for Vercel deployment
# Copy these to your Vercel environment variables

# MongoDB Configuration - REQUIRED
# Get this from MongoDB Atlas or your MongoDB provider
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/

# Database name
DB_NAME=app

# CORS origins - Update with your actual Vercel domain
CORS_ORIGINS=https://your-app-name.vercel.app

# Application URL - Update with your actual Vercel domain  
APP_URL=https://your-app-name.vercel.app

# Logging level for production
LOG_LEVEL=INFO

# Vercel environment indicator (automatically set by Vercel)
# VERCEL=1